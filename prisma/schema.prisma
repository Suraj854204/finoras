generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  brand       String
  category    String
  mrp         Int
  basePrice   Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  emiPlans    EMIPlan[]
  applications Application[]
  @@index([brand])
  @@index([category])
  @@index([basePrice])
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  name         String
  color        String
  storage      String
  image        String
  price        Int
  stock        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  emiPlans     EMIPlan[]
  applications Application[]
  @@index([productId])
  @@index([stock])
}

model EMIPlan {
  id             String          @id @default(cuid())
  productId      String
  variantId      String?
  monthlyPayment Int
  tenureMonths   Int
  interestRate   Decimal         @db.Decimal(5, 2)
  cashback       Int             @default(0)
  processingFee  Int             @default(0)
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  applications   Application[]
  @@index([productId, tenureMonths])
  @@index([variantId])
}

model Application {
  id             String           @id @default(cuid())
  applicationNo  String           @unique
  productId      String
  variantId      String
  emiPlanId      String
  status         ApplicationStatus @default(KYC_PENDING)
  applicantName  String?
  email          String?
  phone          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  product        Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  emiPlan        EMIPlan          @relation(fields: [emiPlanId], references: [id], onDelete: Restrict)
  kyc            KYCRecord?
  @@index([status])
  @@index([createdAt])
}

enum ApplicationStatus {
  KYC_PENDING
  KYC_SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model KYCRecord {
  id               String      @id @default(cuid())
  applicationId    String      @unique
  panLast4         String
  aadhaarLast4     String
  dateOfBirth      DateTime
  addressLine      String
  city             String
  state            String
  pincode          String
  documentVerified Boolean     @default(false)
  consent          Boolean
  status           KYCStatus   @default(SUBMITTED)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([status])
}

enum KYCStatus {
  SUBMITTED
  VERIFIED
  REJECTED
}
